# Copy to .env.local for local development. On Vercel, add the same keys under
# Project → Settings → Environment Variables. Never commit real keys.

# Required. Anthropic API key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Recommended. Free Pl@ntNet key (500 identifications/day) from https://my.plantnet.org
# Without it the app still works, identifying from the photos alone.
PLANTNET_API_KEY=

# Optional. Model for regular diagnoses (default: claude-sonnet-5-5).
CLAUDE_MODEL=
# Optional. Model for the "deep check" button (default: claude-opus-5-5).
CLAUDE_DEEP_MODEL=
# Optional. Effort for regular diagnoses: low | medium | high (default: medium).
CLAUDE_EFFORT=

# Optional. Max diagnoses per 10 minutes per visitor (default: 15).
DIAGNOSE_RATE_LIMIT=
